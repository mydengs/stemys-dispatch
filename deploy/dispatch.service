[Unit]
Description=Stemys Dispatch (推广落地页分发)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/wwwroot/stemys/dispatch
ExecStart=/opt/wwwroot/stemys/dispatch/dispatch /opt/wwwroot/stemys/dispatch/config.json
Restart=on-failure
RestartSec=3
User=www
Group=www
# 便于绑定 80 等低端口（如不需要可去掉）
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
